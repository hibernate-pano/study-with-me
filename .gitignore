# ---------- Next.js ----------
.next/
out/

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- OS ----------
.DS_Store
Thumbs.db

# ---------- Editor ----------
.idea/
.vscode/
*.swp
*.swo

