# =====================================================
# 概念深挖器 · 环境变量模板（MiniMax 国内版）
# =====================================================
# 复制此文件为 `.env`（在项目根目录下），填入真实 Key 即可。
# `.env` 已加入 .gitignore，不会被提交。
#
# 申请 Key：https://platform.minimaxi.com/user-center/basic-information/interface-key
# 接口文档：https://platform.minimaxi.com/docs/api-reference/text-openai-api
#
# 启动：
#   cd frontend && npm run dev
#   （package.json 的 dev 已配 --env-file ../.env，Next 15.3 支持）
# =====================================================


# ============ MiniMax 主 LLM（必填）============
# 国内版 OpenAI 兼容端点
AI_API_URL=https://api.minimaxi.com/v1/chat/completions
# 你的 API Key（在 https://platform.minimaxi.com 账户管理 > 接口密钥 创建）
AI_API_KEY=
# 推荐模型：MiniMax-M3（中文长文本，1M 上下文）；备选 M2.7 / M2.7-highspeed（更快）
AI_MODEL_NAME=MiniMax-M3


# ============ Tavily 联网检索（可选）============
# 不填则"实时资料检索"模块不启用；填了会附加联网资料。
# 申请：https://tavily.com （免费档每月 1000 次）
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5